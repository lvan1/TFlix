{
  "name": "@lvan1/tflix",
  "appName": "TFlix",
  "version": "1.4.3-test.7",
  "description": "TFlix transforms Cineby.at into a TV-friendly experience for Samsung TVs running TizenBrew with enhanced remote navigation.",
  "packageType": "mods",
  "websiteURL": "https://www.cineby.at",
  "main": "dist/userScript-v1.4.3-test.7.js",
  "evaluateScriptOnDocumentStart": false,
  "scripts": {
    "build": "cd mods && npm install && npm run build && cd ../service && npm install && npm run build && cd ..",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run build && npx --yes http-server . --cors -c-1 -p 8080",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "author": "Ivan (forked from Zyrex/TFlix)",
  "serviceFile": "dist/service.js",
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "MediaTrackNext",
    "MediaTrackPrevious"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lvan1/TFlix"
  },
  "bugs": {
    "url": "https://github.com/lvan1/TFlix/issues"
  },
  "homepage": "https://github.com/lvan1/TFlix#readme",
  "keywords": [
    "tizenbrew",
    "tizen",
    "samsung",
    "tv",
    "cineby",
    "streaming"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
